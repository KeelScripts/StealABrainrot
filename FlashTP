-- Creates a ColorSequence for the animated border gradient
local function makeBorderGradient()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(0,   0,   0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40,  80,  180)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(0,   0,   0)),
    })
end

-- Animates a UIGradient's Rotation forever (border shimmer)
local function animateGradient(gradient, baseRotation, speed)
    speed = speed or 45
    task.spawn(function()
        local t = 0
        while gradient and gradient.Parent do
            t = t + RunService.Heartbeat:Wait()
            gradient.Rotation = baseRotation + math.sin(t * (speed / 50)) * 30
        end
    end)
end

-- Animated title text gradient (blue shimmer wave)
local function makeTitleGradient()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0,    Color3.fromRGB(60,  100, 200)),
        ColorSequenceKeypoint.new(0.35, Color3.fromRGB(60,  100, 200)),
        ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(200, 220, 255)),
        ColorSequenceKeypoint.new(0.65, Color3.fromRGB(60,  100, 200)),
        ColorSequenceKeypoint.new(1,    Color3.fromRGB(60,  100, 200)),
    })
end

local function animateTitleGradient(gradient)
    task.spawn(function()
        local t = 0
        while gradient and gradient.Parent do
            t = t + RunService.Heartbeat:Wait()
            gradient.Offset = Vector2.new(math.sin(t * 0.6) * 0.5, 0)
        end
    end)
end

-- Button press animation (quick scale tween via BackgroundTransparency flicker)
local function animateButtonPress(button)
    local originalColor = button.BackgroundColor3
    button.BackgroundColor3 = Color3.fromRGB(40, 60, 100)
    task.delay(0.12, function()
        if button and button.Parent then
            button.BackgroundColor3 = originalColor
        end
    end)
end

-- Toggle knob slide animation
local function animateToggle(knob, toggleFrame, state)
    local onPos  = UDim2.new(1, -14, 0.5, -6)
    local offPos = UDim2.new(0, 2,   0.5, -6)
    local onColor  = Color3.fromRGB(100, 150, 255)
    local offColor = Color3.fromRGB(60,  80,  140)
    local target = state and onPos or offPos
    TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
        Position         = target,
        BackgroundColor3 = state and onColor or offColor,
    }):Play()
end

-- Drag any frame by its header (titleLabel or the frame itself)
local function makeDraggable(frame, dragHandle)
    dragHandle = dragHandle or frame
    local dragging, dragStart, startPos
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement or
            input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Minimize/restore a frame between full size and header-only height
local function makeMinimizable(frame, minBtn, fullHeight, headerHeight)
    headerHeight = headerHeight or 32
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        animateButtonPress(minBtn)
        minimized = not minimized
        minBtn.Text = minimized and "+" or "-"
        TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
            Size = UDim2.new(
                frame.Size.X.Scale, frame.Size.X.Offset,
                0, minimized and headerHeight or fullHeight
            )
        }):Play()
    end)
end

