local function updateHubSlider(val)
    val = math.clamp(val, 0, 1)
    hubSliderValue = val
    hubSliderFill.Size     = UDim2.new(val, 0, 1, 0)
    hubSliderHandle.Position = UDim2.new(val, 0, 0.5, 0)
    hubTriggerPct.Text     = math.floor(val * 100) .. "%"
end

hubSliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        hubSliderDragging = true
        local relX = (input.Position.X - hubSliderTrack.AbsolutePosition.X) / hubSliderTrack.AbsoluteSize.X
        updateHubSlider(relX)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if hubSliderDragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement or
        input.UserInputType == Enum.UserInputType.Touch) then
        local relX = (input.Position.X - hubSliderTrack.AbsolutePosition.X) / hubSliderTrack.AbsoluteSize.X
        updateHubSlider(relX)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        hubSliderDragging = false
    end
end)

